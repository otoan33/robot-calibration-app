// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "robot-calibration",
	"build": {
		"context": "..",
		"dockerfile": "Dockerfile"
	},

	// プロジェクト全体を /workspace にマウントし、編集がそのまま反映されるようにする
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
	"workspaceFolder": "/workspace",

	// 描画 API・解析 API（--reload 付き）と frontend を起動（ログは /tmp/backend.log, /tmp/analysis.log, /tmp/frontend.log）
	"postStartCommand": "nohup uvicorn backend.draw:app --host 0.0.0.0 --port 8000 --reload > /tmp/backend.log 2>&1 & nohup uvicorn backend.analysis:app --host 0.0.0.0 --port 8001 --reload > /tmp/analysis.log 2>&1 & nohup python -m frontend.main > /tmp/frontend.log 2>&1 &",

	"forwardPorts": [8000, 8001, 8080],

	"customizations": {
		"vscode": {
			"extensions": ["ms-python.python"]
		}
	}
}
